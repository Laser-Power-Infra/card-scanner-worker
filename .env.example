# Copy to .env and fill in. .env is loaded automatically by app/config.py.
# DATABASE_URL must point at the SAME Postgres database the Next.js app uses
# (Prisma). Get it from card-scanner/.env.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# RabbitMQ 4 (already running). Used by the queue layer, not by the workers'
# scraping logic itself.
RABBITMQ_URL="amqp://guest:guest@localhost:5672/"

# OpenAI — the workers use the Responses API + built-in web_search to find
# real profile URLs, bios and company details. Same key as the Next.js app.
OPENAI_API_KEY="sk-..."

# Worker behaviour
MAX_ATTEMPTS=3
WORKER_TIMEOUT_MIN=10
PHOTO_POLL_TIMEOUT=30
PHOTO_POLL_INTERVAL=5
SCRAPE_TIMEOUT=8
