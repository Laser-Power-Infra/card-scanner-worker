# Copy to .env and fill in. The repo-root .env is loaded automatically by
# app/shared/config.py, then read by each feature's own config module.
#
# Both features share one Postgres (the same Neon database the Next.js app
# uses via Prisma) and one RabbitMQ broker, but they run as independent
# processes and consume independent queues.

# ── Shared ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
RABBITMQ_URL="amqp://guest:guest@localhost:5672/"
OPENAI_API_KEY="sk-..."

# ── Profile-collection worker (queue CS-profile:collection) ───────────────
# OpenAI Responses API + web_search finds profile URLs, bios, company details.
ENRICH_MODEL=gpt-5.4-mini
ENRICH_EFFORT=low
SEARCH_CONTEXT=medium
MAX_ATTEMPTS=3
WORKER_TIMEOUT_MIN=10
PHOTO_POLL_TIMEOUT=30
PHOTO_POLL_INTERVAL=5
SCRAPE_TIMEOUT=8

# ── Subsidiary-matching worker (queue CS-subsidiary:matching) ─────────────
# Phrase extraction/scoring via OpenAI; search providers are discovered by the
# SEARCH_*_API_KEY prefix and tried in SEARCH_PRIORITY order.
LLM_MODEL=gpt-6-luna
LLM_TEMPERATURE=0
SEARCH_PRIORITY=tavily,exa,serpapi
SEARCH_TAVILY_API_KEY=""
SEARCH_EXA_API_KEY=""
SEARCH_SERPAPI_API_KEY=""
SEARCH_MAX_RESULTS=5
SEARCH_SOFT_COOLDOWN=60
SEARCH_CREDIT_COOLDOWN=21600
SEARCH_SCRAPE_TIMEOUT=8
MATCH_TOP_N=10
MATCH_MAX_PHRASES=30
MATCH_THRESHOLD_DEFAULT=0.5
MATCH_WEIGHT_OWN_BUSINESS=1.0
MATCH_WEIGHT_TECHNICAL=0.6
MATCH_WEIGHT_DEMAND_SIDE=0.3
MATCH_PENALTY_WEIGHT=0.3
PAUSE_PROBE_INTERVAL=60
DIRECT_SITE_FAILURE_COOLDOWN=3600
GENERIC_EMAIL_DOMAINS=""

# Profile enrichment - address pass (Geoapify geocoding)
GEOAPIFY_API_KEY=80e650c58f5a4501a0d03b3b6a30d170
GEOAPIFY_DAILY_CAP=3000
GEOAPIFY_MONTHLY_CAP=70000
GEOAPIFY_USAGE_FILE=data/geoapify_usage.json
GEOAPIFY_TIMEOUT=20
GEOAPIFY_MAX_ATTEMPTS=3
ADDRESS_MODEL=
ADDRESS_TEMPERATURE=0
ADDRESS_MAX_OUTPUT_TOKENS=3000
ADDRESS_VERIFIED_KM=0.5
ADDRESS_APPROXIMATE_KM=25
# A street-level match may survive a wrong/coarse PIN centroid up to this.
ADDRESS_STREET_AREA_KM=50
# How many distinct extracted offices to geocode/save per company.
ADDRESS_MAX_LOCATIONS=3
# TEMPORARY CACHE — remove after the address overhaul. Local JSON only.
# Set ADDRESS_CACHE=0 (or pass --no-cache) to bypass.
ADDRESS_CACHE=1
ADDRESS_CACHE_DIR=data/address_cache
ADDRESS_CACHE_TTL_HOURS=72
ADDRESS_FAILURE_TTL_HOURS=12
